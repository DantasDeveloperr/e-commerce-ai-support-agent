[{"source": "entrega.txt", "content": "PRAZO DE ENTREGA\n\nO prazo de entrega varia de acordo com a regi\u00e3o do cliente e com o m\u00e9todo de envio escolhido no momento da compra.\n\nO cliente pode consultar a previs\u00e3o de entrega informando o n\u00famero do pedido.\n\nPEDIDO ATRASADO\n\nCaso o pedido esteja atrasado em rela\u00e7\u00e3o \u00e0 data estimada de entrega, o cliente deve verificar o c\u00f3digo de rastreamento e acompanhar a atualiza\u00e7\u00e3o junto \u00e0 transportadora.\n\nSe o pedido continuar atrasado, o atendimento pode ser acionado para an\u00e1lise do caso.", "embedding": [-0.0012788665, 0.021966124, -0.025698816, -0.023102622, -0.018824063, 0.042384274, 0.0069170143, -0.001904307, -0.067673266, -0.054164656, 0.00091074564, -0.0046077888, 0.033121888, 0.01599026, -0.0017712103, 0.02199117, 0.05526923, 0.03891365, 0.016212141, 0.0061228853, -0.036761954, -0.003629628, -0.049917452, -0.00551878, -0.018234432, 0.034681186, -0.0102696875, -0.014070184, -0.027238622, 0.22189923, 0.029150793, -0.019483682, -0.018444026, -0.0723535, -0.015829876, -0.00298135, -0.0053805294, 0.0017856205, -0.07974395, -0.025163356, 0.023767198, 0.03869745, -0.030571887, 0.018677272, -0.0031887474, 0.0031945156, -0.041827675, 0.000498906, 0.024277708, 0.03417673, 0.05498279, 0.026186207, -0.023985961, 0.027562443, 0.0051789363, 0.03225827, -0.034277108, -0.035934016, 0.016863815, 0.008077566, -0.012259372, 0.00998878, 0.030601835, -0.013580135, -0.011958472, -0.056158036, 0.010444187, -0.0037832311, -0.035497397, 0.00094229024, 0.058773875, 0.038974717, 0.03761478, 0.04131401, 0.06354552, -0.019021597, -0.040135927, 0.0355372, -0.03590736, 0.050764322, 0.016413385, -0.0334476, 0.010630888, -0.022890491, -0.044407297, 0.047943354, -0.011694947, -0.009668595, -0.014516062, 0.025779279, 0.020275008, -0.008754072, 0.012930118, -0.02394646, -0.008797009, 0.013128481, -0.009739908, 0.0024732288, -0.0036291606, -0.026336867, -0.0015323389, 0.046383265, -0.03125774, -